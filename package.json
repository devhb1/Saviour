{
  "name": "saviours",
  "private": true,
  "version": "0.0.0",
  "description": "SAVIOURS \u2014 security memory for autonomous agents",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @saviours/web dev",
    "sync:runtime": "pnpm exec tsx scripts/sync-runtime-data.ts",
    "build": "pnpm sync:runtime && pnpm --filter @saviours/web build",
    "lint": "pnpm --filter @saviours/web lint",
    "typecheck": "pnpm --filter @saviours/core exec tsc --noEmit && pnpm --filter @saviours/web exec tsc --noEmit",
    "spike:graph": "pnpm --filter @saviours/core exec tsx src/graph/spike.ts",
    "check:normalize": "pnpm --filter @saviours/core exec tsx src/evidence/normalize.check.ts",
    "check:confidence": "pnpm --filter @saviours/core exec tsx src/confidence.check.ts",
    "check:force-fresh": "pnpm --filter @saviours/core exec tsx src/investigator/forceFresh.check.ts",
    "check:clean-pin": "pnpm --filter @saviours/core exec tsx src/shield/cleanPin.check.ts",
    "check:standard": "pnpm --filter @saviours/core exec tsx src/graph/standard.check.ts",
    "check:evidence": "pnpm --filter @saviours/core exec tsx src/evidence/gate.check.ts",
    "spike:ai": "pnpm --filter @saviours/core exec tsx src/investigator/spike.ts",
    "check:investigate": "pnpm --filter @saviours/core exec tsx src/investigator/live.check.ts",
    "eval:rules": "pnpm exec tsx evals/run-rules.ts",
    "eval:live": "pnpm exec tsx evals/run-live.ts",
    "eval:investigate": "pnpm exec tsx evals/run-live.ts --investigate",
    "deploy:record": "pnpm exec tsx scripts/record-deployment.ts",
    "check:registry-ids": "pnpm --filter @saviours/core exec tsx src/registry/ids.check.ts",
    "check:remember": "pnpm --filter @saviours/core exec tsx src/registry/remember.check.ts",
    "check:shield": "pnpm --filter @saviours/core exec tsx src/shield/sepolia.gate.ts",
    "check:shield-local": "pnpm --filter @saviours/core exec tsx src/shield/local.gate.ts",
    "check:registry-local": "bash scripts/check-registry-local.sh",
    "check:hero-loop": "bash scripts/check-registry-local.sh",
    "spike:ens": "pnpm --filter @saviours/core exec tsx src/ens/spike.ts",
    "migrate:saviours-eth": "pnpm --filter @saviours/core exec tsx src/ens/migrateToSavioursEth.ts",
    "check:ens-resolve": "pnpm --filter @saviours/core exec tsx src/ens/resolve.check.ts",
    "check:ens-roles": "pnpm --filter @saviours/core exec tsx src/ens/roles.check.ts",
    "check:ens-story": "pnpm --filter @saviours/core exec tsx src/ens/story.check.ts",
    "check:remember-ens": "pnpm --filter @saviours/core exec tsx src/ens/remember.gate.ts",
    "check:govern": "pnpm --filter @saviours/core exec tsx src/ens/dispute.check.ts",
    "check:cooccur": "pnpm --filter @saviours/core exec tsx src/evidence/cooccurrence.check.ts",
    "seed:incidents": "pnpm exec tsx scripts/seed-incidents.ts",
    "check:seed": "pnpm exec tsx scripts/seed-incidents.ts --check",
    "check:dossier": "pnpm --filter @saviours/core exec tsx src/dossier/pin.check.ts",
    "check:provenance": "pnpm exec tsx scripts/check-provenance.ts",
    "check:plain-shield": "pnpm exec tsx scripts/check-plain-shield.ts",
    "check:incidents": "pnpm exec tsx scripts/check-incidents.ts",
    "p0:discover": "pnpm exec tsx scripts/p0-discover.ts",
    "test:contracts": "forge test --root contracts",
    "test": "pnpm test:contracts && pnpm eval:rules && pnpm check:registry-ids",
    "mcp": "pnpm --filter @saviours/mcp start",
    "check:mcp": "pnpm --filter @saviours/mcp check"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
