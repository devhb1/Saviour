{
  "name": "saviours",
  "private": true,
  "version": "0.0.0",
  "description": "SAVIOURS — security memory for autonomous agents",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @saviours/web dev",
    "build": "pnpm --filter @saviours/web build",
    "lint": "pnpm --filter @saviours/web lint",
    "typecheck": "pnpm --filter @saviours/core exec tsc --noEmit && pnpm --filter @saviours/web exec tsc --noEmit",
    "spike:graph": "pnpm --filter @saviours/core exec tsx src/graph/spike.ts",
    "check:normalize": "pnpm --filter @saviours/core exec tsx src/evidence/normalize.check.ts",
    "check:evidence": "pnpm --filter @saviours/core exec tsx src/evidence/gate.check.ts",
    "spike:ai": "pnpm --filter @saviours/core exec tsx src/investigator/spike.ts",
    "check:investigate": "pnpm --filter @saviours/core exec tsx src/investigator/live.check.ts",
    "eval:rules": "pnpm exec tsx evals/run-rules.ts",
    "eval:live": "pnpm exec tsx evals/run-live.ts",
    "eval:investigate": "pnpm exec tsx evals/run-live.ts --investigate",
    "deploy:record": "pnpm exec tsx scripts/record-deployment.ts",
    "check:registry-ids": "pnpm --filter @saviours/core exec tsx src/registry/ids.check.ts",
    "check:remember": "pnpm --filter @saviours/core exec tsx src/registry/remember.check.ts",
    "check:registry-local": "bash scripts/check-registry-local.sh",
    "test:contracts": "forge test --root contracts",
    "test": "pnpm test:contracts && pnpm eval:rules && pnpm check:registry-ids"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
